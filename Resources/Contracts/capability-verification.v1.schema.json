{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "ue.capability-verification.v1",
  "title": "UE AI capability verification state",
  "description": "Transport-wide execution state attached to every capability result. Null means the handler did not produce that proof.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "capability",
    "localDeclared",
    "handlerRegistered",
    "liveAvailable",
    "executed",
    "readbackVerified",
    "runtimeVerified"
  ],
  "properties": {
    "schema": {
      "const": "ue.capability-verification.v1"
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "localDeclared": {
      "type": "boolean"
    },
    "handlerRegistered": {
      "type": "boolean"
    },
    "liveAvailable": {
      "type": "boolean"
    },
    "executed": {
      "type": "boolean"
    },
    "readbackVerified": {
      "type": ["boolean", "null"]
    },
    "runtimeVerified": {
      "type": ["boolean", "null"]
    }
  }
}
