{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ue.agent-skill.v1",
  "title": "UE Agent Skill package",
  "type": "object",
  "required": [
    "schema",
    "schemaVersion",
    "id",
    "version",
    "title",
    "description",
    "domains",
    "risk",
    "triggers",
    "entrypoint",
    "requirements",
    "recipes",
    "resources"
  ],
  "properties": {
    "schema": {
      "const": "ue.agent-skill.v1"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "blueprint",
          "scene",
          "content",
          "animation",
          "ai",
          "production"
        ]
      }
    },
    "risk": {
      "$ref": "#/$defs/risk"
    },
    "triggers": {
      "$ref": "#/$defs/nonEmptyStrings"
    },
    "entrypoint": {
      "const": "SKILL.md"
    },
    "requirements": {
      "type": "object",
      "required": [
        "capabilities"
      ],
      "properties": {
        "engine": {
          "type": "object",
          "properties": {
            "min": {
              "type": "string",
              "minLength": 1
            },
            "maxExclusive": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "plugins": {
          "$ref": "#/$defs/strings"
        },
        "capabilities": {
          "$ref": "#/$defs/nonEmptyStrings"
        },
        "optionalCapabilities": {
          "$ref": "#/$defs/strings"
        }
      },
      "additionalProperties": false
    },
    "recipes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "risk",
          "inputs",
          "steps",
          "result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "risk": {
            "$ref": "#/$defs/risk"
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "name",
                "type",
                "required",
                "description"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "type": {
                  "enum": [
                    "string",
                    "integer",
                    "number",
                    "boolean",
                    "object",
                    "array"
                  ]
                },
                "required": {
                  "type": "boolean"
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "example": true
              },
              "additionalProperties": false
            }
          },
          "steps": {
            "type": "array",
            "minItems": 3,
            "items": {
              "type": "object",
              "required": [
                "id",
                "phase",
                "purpose",
                "operations"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "phase": {
                  "enum": [
                    "discover",
                    "execute",
                    "verify"
                  ]
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "operations": {
                  "$ref": "#/$defs/nonEmptyStrings"
                },
                "route": {
                  "enum": [
                    "domain",
                    "workflow"
                  ]
                },
                "optional": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            }
          },
          "result": {
            "type": "object",
            "required": [
              "summary",
              "evidence",
              "success"
            ],
            "properties": {
              "summary": {
                "type": "string",
                "minLength": 1
              },
              "evidence": {
                "$ref": "#/$defs/nonEmptyStrings"
              },
              "success": {
                "$ref": "#/$defs/nonEmptyStrings"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "description"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "risk": {
      "enum": [
        "readOnly",
        "safeWrite",
        "confirmWrite",
        "mixed"
      ]
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "nonEmptyStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
