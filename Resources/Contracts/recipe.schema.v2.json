{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ue-ai-cli.local/contracts/recipe.schema.v2.json",
  "title": "UE Recipe v2",
  "type": "object",
  "required": ["schema", "id", "version", "steps"],
  "properties": {
    "schema": { "const": "ue.recipe.v2" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{0,127}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "description": { "type": "string", "maxLength": 1024 },
    "inputs": { "type": "object" },
    "sessionPolicy": {
      "type": "object",
      "properties": {
        "requirePieStopped": { "const": true },
        "runnerStartsPie": { "const": true },
        "lease": { "const": "pie" },
        "editorInstanceBound": { "const": true }
      },
      "required": ["requirePieStopped", "runnerStartsPie", "lease", "editorInstanceBound"],
      "additionalProperties": false
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "kind"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
          "kind": { "enum": ["capability", "sessionCapability", "workflow", "poll", "condition", "approval", "sourceControlCheckout"] },
          "capability": { "type": "string", "maxLength": 192 },
          "params": { "type": "object" },
          "workflow": { "type": "object" },
          "approvePlanDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "condition": { "type": "object" },
          "poll": { "type": "object" },
          "retry": {
            "type": "object",
            "properties": {
              "maxAttempts": { "type": "integer", "minimum": 1, "maximum": 5 },
              "backoffMs": { "type": "integer", "minimum": 0, "maximum": 30000 },
              "transientErrors": { "type": "array", "maxItems": 16, "items": { "type": "string", "maxLength": 128 } }
            },
            "additionalProperties": false
          },
          "compensate": {
            "type": "object",
            "properties": {
              "kind": { "enum": ["capability", "sessionCapability", "workflow"] },
              "capability": { "type": "string", "maxLength": 192 },
              "params": { "type": "object" },
              "runId": { "type": "string" },
              "approvePlanDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
            },
            "required": ["kind"],
            "additionalProperties": false
          },
          "highRisk": { "type": "boolean" }
        },
        "not": {
          "anyOf": [
            { "required": ["script"] },
            { "required": ["shell"] },
            { "required": ["python"] },
            { "required": ["javascript"] },
            { "required": ["while"] }
          ]
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
