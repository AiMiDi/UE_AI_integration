{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ue-ai-integration.local/contracts/ue.job.v1.schema.json",
  "title": "UE durable job",
  "type": "object",
  "required": [
    "schema",
    "jobId",
    "kind",
    "status"
  ],
  "properties": {
    "schema": {
      "const": "ue.job.v1"
    },
    "jobId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "capability": {
      "type": "string",
      "minLength": 3
    },
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "interrupted"
      ]
    },
    "progress": {
      "type": "object",
      "properties": {
        "fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "phase": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "createdAt": {
      "type": "string"
    },
    "startedAt": {
      "type": "string"
    },
    "finishedAt": {
      "type": "string"
    },
    "exitCode": {
      "type": "integer"
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "result": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
