{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ue-ai-integration.local/contracts/ue.finding.v1.schema.json",
  "title": "UE engineering finding",
  "type": "object",
  "required": [
    "schema",
    "findingId",
    "ruleId",
    "severity",
    "confidence",
    "message",
    "location",
    "evidence",
    "runtimeStatus"
  ],
  "properties": {
    "schema": {
      "const": "ue.finding.v1"
    },
    "findingId": {
      "type": "string",
      "minLength": 1
    },
    "ruleId": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "location": {
      "type": "object",
      "required": [
        "assetPath"
      ],
      "properties": {
        "assetPath": {
          "type": "string",
          "minLength": 1
        },
        "graph": {
          "type": "string"
        },
        "nodeGuid": {
          "type": "string"
        },
        "property": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "evidence": {
      "type": "object"
    },
    "runtimeStatus": {
      "enum": [
        "hypothesis",
        "corroborated",
        "contradicted",
        "notObserved"
      ]
    }
  },
  "additionalProperties": true
}
