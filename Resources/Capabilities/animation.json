        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Blueprint name"
          },
          "packagePath": {
            "type": "string",
            "description": "Package path"
          },
          "skeleton": {
            "type": "string",
            "description": "Skeleton name or path"
          },
          "parentClass": {
            "type": "string",
            "description": "Parent class (default AnimInstance)"
          }
