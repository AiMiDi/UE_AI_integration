    {
      "id": "animation.blend_space.create",
      "domain": "animation",
      "kind": "command",
      "description": "Create a new 2D Blend Space asset.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Blend space name"
          },
          "packagePath": {
            "type": "string",
            "description": "Package path"
          },
          "skeleton": {
            "type": "string",
            "description": "Skeleton name or path"
          }
        },
        "required": [
          "name",
          "packagePath",
          "skeleton"
        ],
        "additionalProperties": false
      },
      "traits": {
        "readOnly": false,
        "destructive": true,
        "expensive": false
      },
      "output": {
        "kind": "json"
      }
    },
    {
      "id": "animation.blend_space.samples.set",
      "domain": "animation",
      "kind": "command",
      "description": "Set animation samples and axis parameters on a Blend Space.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "blendSpace": {
            "type": "string",
            "description": "Blend Space name or path"
          },
          "samples": {
            "type": "array",
            "items": {},
            "description": "Array of {animationAsset, x, y}"
          },
          "axisXName": {
            "type": "string",
            "description": "X axis display name"
          },
          "axisYName": {
            "type": "string",
            "description": "Y axis display name"
          },
          "axisXMin": {
            "type": "number",
            "description": "X axis minimum"
          },
          "axisXMax": {
            "type": "number",
            "description": "X axis maximum"
          },
          "axisYMin": {
            "type": "number",
            "description": "Y axis minimum"
          },
          "axisYMax": {
            "type": "number",
            "description": "Y axis maximum"
          }
        },
        "required": [
          "blendSpace"
        ],
        "additionalProperties": false
      },
      "traits": {
        "readOnly": false,
        "destructive": true,
        "expensive": false
      },
      "output": {
        "kind": "json"
      }
    },
    {
      "id": "animation.blueprint.create",
      "domain": "animation",
      "kind": "command",
