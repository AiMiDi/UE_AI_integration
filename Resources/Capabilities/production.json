    {
      "id": "production.scenario.validate",
      "domain": "production",
      "kind": "validation",
      "description": "Validate a bounded runtime scenario AST without starting PIE or executing actions.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "scenario": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "steps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 128
                    },
                    "action": {
                      "type": "string",
                      "enum": [
                        "pie.start",
                        "pie.stop",
                        "pie.restart",
                        "pie.pause",
                        "pie.resume",
                        "wait",
                        "object.find",
                        "object.get",
                        "object.set",
                        "object.call",
                        "widget.tree",
                        "widget.state",
                        "delegate.bind",
                        "delegate.unbind",
                        "delegate.list",
                        "delegate.is_bound",
                        "delegate.broadcast",
                        "widget.click",
                        "widget.drag",
                        "widget.focus",
                        "widget.hitTest",
                        "input.key",
                        "input.mode",
                        "viewport.capture",
                        "log.capture",
                        "frameTime.sample"
                      ]
                    },
                    "params": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "timeoutMs": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 300000
                    },
                    "assertions": {
                      "type": "array",
                      "maxItems": 64,
                      "items": {
                        "type": "object",
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "equals",
                              "exists",
                              "widgetState",
                              "delegateBound",
                              "hitTestContains",
                              "logNotContains",
                              "imageDiff"
                            ]
                          },
                          "actual": {
                            "description": "Literal value or JSON Pointer binding evaluated by the scenario runner"
                          },
                          "expected": {
                            "description": "Expected JSON-compatible assertion value"
                          },
                          "params": {
                            "type": "object",
                            "additionalProperties": true
                          }
                        },
                        "required": [
                          "type"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "id",
                    "action"
                  ],
                  "additionalProperties": false
                }
              },
              "timeoutMs": {
                "type": "integer",
                "minimum": 1,
                "maximum": 3600000
              },
              "cleanup": {
                "type": "object",
                "properties": {
                  "stopPie": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "stopPie"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "steps"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "scenario"
        ],
        "additionalProperties": false
      },
      "traits": {
        "readOnly": true,
        "destructive": false,
        "expensive": false
      },
      "output": {
        "kind": "json"
      }
    },
