{
  "dsl": "ue.workflow",
  "dslVersion": "1.0",
  "workflowKind": "assetEdit",
  "workflowId": "material-function-batch",
  "scope": {
    "kind": "materialFunction",
    "asset": "/Game/Automation/MF_WorkflowBatch",
    "createIfMissing": true
  },
  "persistence": "dirtyOnly",
  "operations": [
    {
      "id": "input",
      "type": "content.material.expression.add",
      "params": {
        "expressionClass": "FunctionInput",
        "posX": -400,
        "posY": 0
      }
    },
    {
      "id": "configureInput",
      "type": "content.material.function.interface.set",
      "params": {
        "name": "Value",
        "inputType": "Scalar",
        "usePreviewValueAsDefault": true
      },
      "bindings": {
        "/nodeId": {
          "from": "input",
          "path": "/nodeId"
        }
      }
    },
    {
      "id": "output",
      "type": "content.material.expression.add",
      "params": {
        "expressionClass": "FunctionOutput",
        "posX": 100,
        "posY": 0
      }
    },
    {
      "id": "configureOutput",
      "type": "content.material.function.interface.set",
      "params": {
        "name": "Result"
      },
      "bindings": {
        "/nodeId": {
          "from": "output",
          "path": "/nodeId"
        }
      }
    },
    {
      "id": "connect",
      "type": "content.material.pin.connect",
      "params": {
        "sourcePinName": "Output",
        "targetPinName": "Input"
      },
      "bindings": {
        "/sourceNodeId": {
          "from": "input",
          "path": "/nodeId"
        },
        "/targetNodeId": {
          "from": "output",
          "path": "/nodeId"
        }
      }
    }
  ]
}
